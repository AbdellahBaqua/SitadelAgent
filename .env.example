# Copiez ce fichier en .env (jamais commité) et collez votre ou vos clés.

# Fournisseur LLM utilisé par les agents : groq, gemini ou nvidia
LLM_PROVIDER=gemini

# Groq (console.groq.com) — quota gratuit gpt-oss-120b : 8 000 jetons/min, 200 000 jetons/jour
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (aistudio.google.com) — limites visibles dans AI Studio
GEMINI_API_KEY=
# Laisser vide puis lancer `python -X utf8 src\list_models.py` pour choisir un modèle disponible
GEMINI_MODEL=

# NVIDIA NIM (build.nvidia.com) - LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Un modèle par agent (optionnel ; sinon le modèle du fournisseur)
MODEL_CLASSIFICATION=
MODEL_EXPLORATION=
